# Configuration for Jhon Quirama's Portfolio

# Canonical production URL. Do not put a Vercel deployment URL here
# (my-portfolio-<hash>-jhonqs-projects.vercel.app): Google rejects those in the sitemap.
NEXT_PUBLIC_SITE_URL=https://my-portfolio-jhonqs-projects.vercel.app

# Supabase Credentials (Get these free from https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend Email Service (Get free API key at https://resend.com - 3000 emails/month free)
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECEIVER_EMAIL=quirama80@gmail.com
